# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Git LFS for game images (added 2026-10 / chore/lfs-new-images).
# Only files committed AFTER this rule (new files, or existing files when they
# are next modified) are stored as LFS pointers. Existing history is NOT
# migrated. See AGENTS.md "画像と Git LFS".
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.png filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.jpg filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.webp filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.gif filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.png filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.jpg filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.webp filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.gif filter=lfs diff=lfs merge=lfs -text
