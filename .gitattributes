# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Git LFS for game images (added 2026-10 / chore/lfs-new-images).
# assets/ and remake/img/: only NEW images are stored as LFS pointers. Images
# that already existed are pinned as ordinary Git files by the generated block
# at the end of this file.
# asset_sources/: images, videos, zip and pdf are all LFS since 2026-11-11
# (existing files converted in one commit, owner decision). Only the folders CI
# reads (tools/ci/suites.json "sparse") and shisha-hardware-reference/ stay
# ordinary Git through the same generated block.
# Regenerate the block with tools/gen_lfs_legacy_attributes.sh right before
# merging. Existing history is NOT rewritten. See AGENTS.md "画像と Git LFS".
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.png filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.jpg filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.webp filter=lfs diff=lfs merge=lfs -text
remake/img/**/*.gif filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.png filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.jpg filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.webp filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.gif filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.webm filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.mov filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.zip filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.pdf filter=lfs diff=lfs merge=lfs -text


assets/audio/dj/*.mp3 filter=lfs diff=lfs merge=lfs -text

