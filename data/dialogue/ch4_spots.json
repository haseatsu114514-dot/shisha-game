{
  "dialogues": [
    {
      "dialogue_id": "ch4_dubai_souq",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "ドバイの旧市街、スパイス・スーク（市場）へと足を運んだ。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "店先の籠に、赤い粉のスパイスが山になっていた。店主が量り売りの匙を、ひとつ差し出す。"
        },
        {
          "speaker": "hajime",
          "face": "smile",
          "text": "（……この香り、ミックスに使えるかもしれない）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "本場の香りに触れた。甘さの奥にも、スパイスの香りが重なっている。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "……【センス】と【洞察】が少し上がった。"
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "市場をあとにする",
              "next_id": "ch4_return"
            }
          ]
        }
      ]
    },
    {
      "dialogue_id": "ch4_dubai_cafe",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "ドバイの中心地にある超高級カフェに入った。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "奥の席で、店員が客の前に水を置いていく。隣のテーブルの会話は、聞いたことのない言葉だった。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "通訳アプリの画面を見せると、店員がうなずいて奥の席へ案内してくれた。"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（一台70ディルハム、3,000円くらいか。炭籠の係が、席の間をずっと回ってる）"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（今日は、どんな席で吸えるんだろう）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "席に水が置かれた。店員は隣の客の様子にも目を配っている。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "……【センス】と【魅力】が少し上がった。"
        }
      ]
    },
    {
      "dialogue_id": "ch4_return",
      "lines": []
    }
  ]
}
