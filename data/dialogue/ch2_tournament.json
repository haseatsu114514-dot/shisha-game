{
  "comment": "第2章DAY14。実制作の前後だけ。既存関係・LIMEを消さず、味覚回復と離脱理由は後章に残す。",
  "dialogues": [
    {
      "dialogue_id": "ch2_tournament_lobby",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "県大会の控室。あげはが、ドアの前で足を止めた。"
        },
        {
          "type": "condition",
          "condition_type": "met",
          "char_id": "ageha",
          "next_true": "known",
          "next_false": "first"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "顔色、悪くないですか？"
        },
        {
          "speaker": "ageha",
          "face": "smile",
          "text": "……なんでもない。うちの一台、ちゃんと見てて"
        },
        {
          "speaker": "",
          "face": "",
          "text": "笑っているのに、鞄を握る指はほどけなかった。"
        },
        {
          "type": "condition",
          "condition_type": "flag",
          "flag": "_ch2_ageha_secret",
          "next_true": "secret"
        }
      ],
      "branches": {
        "known": [
          {
            "speaker": "ageha",
            "face": "smile",
            "text": "ハジメっち。来たね。今日は、同じ舞台だ"
          }
        ],
        "first": [
          {
            "speaker": "ageha",
            "face": "normal",
            "text": "MELTY PUFFのあげは。……ハジメっち、だよね"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "はい。蒸野はじめです。よろしくお願いします"
          }
        ],
        "secret": [
          {
            "speaker": "hajime",
            "face": "serious",
            "text": "（朝、指を確かめる話を思い出す。……今日は、ダメな日なのかもしれない）"
          },
          {
            "speaker": "ageha",
            "face": "sad",
            "text": "……見なかったことにして。お願い"
          }
        ]
      }
    },
    {
      "dialogue_id": "ch2_tournament_entrance",
      "lines": [
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "HAZE: OPEN CLOUD！　4人一斉、一発勝負でお送りします！"
        },
        {
          "type": "condition",
          "condition_type": "met",
          "char_id": "kumicho",
          "next_true": "kanzaki_known",
          "next_false": "kanzaki_first"
        },
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "神崎竜二選手！　その肩書きも、ご自身からどうぞ"
        },
        {
          "speaker": "kumicho",
          "face": "serious",
          "text": "──おう、そのとおり。俺はヤクザだ"
        },
        {
          "speaker": "kumicho",
          "face": "smile",
          "text": "だが今日は、いち職人として来た。文句なら、俺の煙に言いな"
        },
        {
          "type": "condition",
          "condition_type": "met",
          "char_id": "rei",
          "next_true": "rei_known",
          "next_false": "rei_first"
        },
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "そしてMELTY PUFFのあげは選手、tonariの蒸野はじめ選手！"
        },
        {
          "speaker": "",
          "face": "",
          "text": "4台の向こうで、上園、チャコール博士、南雲が席についた。"
        }
      ],
      "branches": {
        "kanzaki_known": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（神崎さんだ。今日は、あの人も対戦相手なんだ）"
          }
        ],
        "kanzaki_first": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（あの大きな人も、出場者か。名前を聞くのは初めてだ）"
          }
        ],
        "rei_known": [
          {
            "speaker": "rei",
            "face": "smile",
            "text": "また会ったな。今日は、煙で話そう"
          }
        ],
        "rei_first": [
          {
            "speaker": "rei",
            "face": "smile",
            "text": "零-ZERO-のREI。今日の煙、楽しみにしてる"
          }
        ]
      }
    },
    {
      "dialogue_id": "ch2_tournament_rules",
      "lines": [
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "課題はストロベリー！　支給する葉は、アフサールの新作です"
        },
        {
          "speaker": "maezono",
          "face": "serious",
          "text": "一人につき一台。吸い出して提供したあとも、2回の調整まで見ます"
        },
        {
          "speaker": "dr_kemuri",
          "face": "smile",
          "text": "私たちは、一人10点ずつ持っている。気になった煙へ、途中でも投入するよ"
        },
        {
          "speaker": "nagumo",
          "face": "serious",
          "text": "一度入れた点は戻さない。最後に合計して、県代表を決める"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（香りの輪郭が、まだつかめない。でも、手順は忘れていない）"
        },
        {
          "type": "condition",
          "condition_type": "flag",
          "flag": "_ch2_afsahr_tasting",
          "next_true": "tasted"
        },
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "準備ができた選手から、制作を始めてください！"
        }
      ],
      "branches": {
        "tasted": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（試煙会で吸った苺だ。熱に弱い。神崎さんは、炭を一つ抜いていた）"
          }
        ]
      }
    },
    {
      "dialogue_id": "ch2_tournament_farewell",
      "lines": [
        {
          "speaker": "pakki",
          "face": "excited",
          "text": "県代表は、tonariの蒸野はじめ選手です！"
        },
        {
          "speaker": "",
          "face": "",
          "text": "トロフィーを受け取る。あげはの姿が、客席の出口に見えた。"
        },
        {
          "speaker": "hajime",
          "face": "surprise",
          "text": "あげはさん！　もう帰るんですか？"
        },
        {
          "speaker": "ageha",
          "face": "sad",
          "text": "……ごめん。理由は、聞かないで"
        },
        {
          "speaker": "hajime",
          "face": "sad",
          "text": "……また、お店に行きます"
        },
        {
          "speaker": "",
          "face": "",
          "text": "あげはは小さくうなずいて、扉の向こうへ消えた。"
        }
      ]
    },
    {
      "dialogue_id": "ch2_tournament_tasteless",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "片づけの済んだ台で、自分の一台を確かめた。煙は出る。味の輪郭は戻らない。"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "（勝った。嬉しいはずなのに、体が追いつかない）"
        },
        {
          "type": "condition",
          "condition_type": "flag",
          "flag": "_ch2_no_audience",
          "next_true": "alone",
          "next_false": "other"
        },
        {
          "speaker": "",
          "face": "",
          "text": "スマホには、おめでとうの文字が届いていた。勝ったことを喜んでくれる人がいる。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "ありがとう、と打つ。送信するまで、ずいぶん時間がかかった。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "スミさんから、新しいメッセージが届いた。"
        }
      ],
      "branches": {
        "alone": [
          {
            "speaker": "",
            "face": "",
            "text": "空いた応援席を見た。来ないでほしいと送ったのは、自分だった。"
          }
        ],
        "other": [
          {
            "type": "condition",
            "condition_type": "flag",
            "flag": "_ch2_audience_welcome",
            "next_true": "welcome",
            "next_false": "old_save"
          }
        ],
        "welcome": [
          {
            "speaker": "",
            "face": "",
            "text": "出口でつむぎが手を振っていた。礼を言おうとして、声が詰まった。"
          }
        ],
        "old_save": [
          {
            "speaker": "",
            "face": "",
            "text": "片づけが終わると、ようやくスマホを見る余裕ができた。"
          }
        ]
      }
    }
  ]
