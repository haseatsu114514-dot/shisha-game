{
  "dialogues": [
    {
      "dialogue_id": "ch3_tsumugi_slump",
      "metadata": {
        "set_romance_progress": "tsumugi"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "東京。試作を繰り返す俺のそばに、つむぎが立っていた。"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "つむぎちゃん、どうして東京に？"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……美術館を見に来て。少し、寄りました"
        },
        {
          "speaker": "",
          "face": "",
          "text": "一口吸ったつむぎが、スケッチブックを開いた。"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……今日は、いつもと違う色ですね"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "……やっぱり、変なのかな"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "変わるのは、いつものことです"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "でも今日は、ずっと息を止めてるみたい"
        },
        {
          "speaker": "",
          "face": "",
          "text": "煙の線の横に、葉のない耳の猫が寝ていた。"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……この絵、描き終わりました"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "今日も、窓辺で寝てるね"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……はい。前に見た景色も、今日の景色も入ってます"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "（誰かの手つきも、残ったままでいいのか）"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……今日は、少し休みませんか"
        },
        {
          "speaker": "",
          "face": "",
          "text": "トングを置く。考えるのは、それからでもよかった。"
        },
        {
          "type": "apply",
          "stats": {
            "guts": 3,
            "sense": 3
          }
        }
      ]
    }
  ]
}
