      "branches": {
        "eve_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "閉店した店のメニューを、二人で外から眺める。"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "このパフェ、仕込み大変そう。……休みなのに見ちゃうね"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "栞さん、店の話をしてる時も楽しそうだ"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "うん。みんとでいるのも、好きだから"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "でも今夜は、隣の彼氏にアイスをねだりたいな"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "一個ずつ？"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "半分こ、……違う味、頼もうよ"
          }
        ],
        "eve_dubai": [
          {
            "speaker": "",
            "face": "",
            "text": "宿の近くの屋台。よく伸びるアイスを、ミントさんが真剣な顔で見ていた。"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "練って伸ばすんだって。……これ、店で出せないかな"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "休みなのに、また仕込みの顔してる"
          },
          {
            "speaker": "minto",
            "face": "ura_smile",
            "text": "してた？　……じゃあ今夜は、彼氏とアイスだけ"
          },
          {
            "speaker": "minto",
            "face": "ura_normal",
            "text": "半分こしよ。違う味で、どっちが勝つか決めるの"
          },
          {
            "speaker": "",
            "face": "",
            "text": "スプーンを二本もらうと、栞さんが嬉しそうに肩を寄せてきた。"
          }
        ],
        "stay": [
          {
            "speaker": "",
            "face": "",
            "text": "アイスが溶けるまで、どっちの味が勝ちか言い合った。"
          },
