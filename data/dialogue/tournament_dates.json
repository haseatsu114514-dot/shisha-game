      "branches": {
        "eve_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "サメちゃんは、小さな土産袋を抱えていた。"
          },
          {
            "speaker": "samechan",
            "face": "normal",
            "text": "常連の分じゃ、……これは、お主の分"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "俺にも、ですか？　同じ町に来てるのに"
          },
          {
            "speaker": "samechan",
            "face": "normal",
            "text": "お主の分は、わしが一人で選んだのじゃ、……黙って受け取れ"
          },
          {
            "speaker": "samechan",
            "face": "ventriloquism",
            "text": "勇者はじめよ、店主の手が空いたぞ",
            "voice": "korochan"
          },
          {
            "speaker": "samechan",
            "face": "normal",
            "text": "……コロちゃん。そこまで頼んではおらぬ"
          },
          {
            "speaker": "",
            "face": "",
            "text": "俺が手を差し出すと、サメちゃんは土産袋を持ち替えた。"
          }
        ],
        "eve_dubai": [
          {
            "speaker": "",
            "face": "",
