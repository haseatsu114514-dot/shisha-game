      "branches": {
        "eve_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "ましろちゃんが、温かいお茶を二つ買ってきた。"
          },
          {
            "speaker": "mashiro",
            "face": "normal",
            "text": "僕が買う番。……前は、はじめくんだったでしょ"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "覚えてたんだ"
          },
          {
            "speaker": "mashiro",
            "face": "normal",
            "text": "ん、お世話係、ひとりにしない"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "じゃあ次、俺が選ぶ"
          },
          {
            "speaker": "mashiro",
            "face": "normal",
            "text": "次も会うの、今決まったねぇ"
          },
          {
            "speaker": "",
            "face": "",
            "text": "彼女は俺の肩に少し寄りかかり、お茶が冷めるまで黙っていた。"
          }
        ],
        "eve_dubai": [
          {
            "speaker": "",
            "face": "",
            "text": "ましろちゃんが、屋台の甘いミルクティーを二つ買ってきた。"
          },
          {
            "speaker": "mashiro",
            "face": "normal",
            "text": "こっちのお茶、甘いんだって。……僕、けっこう好きかも"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "甘いの、ちょっと意外だな"
          },
          {
            "speaker": "mashiro",
            "face": "normal",
            "text": "甘いのは、急いで飲めないから。ゆっくりできるの"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "じゃあ、飲み終わるまでここにいよう"
          },
          {
            "speaker": "mashiro",
            "face": "smile",
            "text": "ん、明日の分まで、ここで休んでいこうねぇ"
          },
          {
            "speaker": "",
            "face": "",
            "text": "彼女は俺の肩に少し寄りかかり、湯気が消えるまで黙っていた。"
          }
        ],
        "stay": [
          {
            "speaker": "",
            "face": "",
            "text": "冷めたお茶を、二人とも捨てずに最後まで飲んだ。"
          },
          {
            "type": "condition",
            "condition_type": "tournament_finished",
