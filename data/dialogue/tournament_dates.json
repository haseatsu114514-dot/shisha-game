      "branches": {
        "eve_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "二人で駅前のベンチに座る。つむぎは旅先の木を描いていた。"
          },
          {
            "speaker": "tsumugi",
            "face": "normal",
            "text": "……明日は、手だけ描いても、いいですか"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "顔じゃなくて？"
          },
          {
            "speaker": "tsumugi",
            "face": "normal",
            "text": "炭を待っている時の手、好きなので"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "じゃあ今は？"
          },
          {
            "speaker": "tsumugi",
            "face": "normal",
            "text": "……今は、貸してください"
          },
          {
            "speaker": "",
            "face": "",
            "text": "鉛筆をしまったつむぎの指が、俺の手を握った。"
          }
        ],
        "eve_dubai": [
          {
            "speaker": "",
            "face": "",
            "text": "宿の前のベンチ。つむぎは、葉が空へ開く見慣れない木を描いていた。"
          },
          {
            "speaker": "tsumugi",
            "face": "normal",
            "text": "……知らない木なのに、描くと、いつもの線が混ざります"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "俺の明日の一台も、そうかもしれない"
          },
          {
            "speaker": "tsumugi",
            "face": "smile",
            "text": "……はい。描いてる手が同じなら、たぶん、大丈夫です"
          },
          {
            "speaker": "",
            "face": "",
            "text": "鉛筆を置いたつむぎが、そっと俺の手を取った。"
          }
        ],
        "stay": [
          {
            "speaker": "",
            "face": "",
            "text": "つむぎがもう一枚だけ描き終えるのを、隣で待った。"
          },
          {
            "type": "condition",
            "condition_type": "tournament_finished",
            "tournament_chapter": 3,
            "next_true": "stay_dubai",
            "next_false": "stay_tokyo"
          }
        ],
        "home": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "会えてよかった。……手、ありがとう"
          },
          {
            "speaker": "",
            "face": "",
            "text": "つむぎは描きかけのページの角を小さく折って、握っていたほうの手を振った。"
          }
        ],
        "stay_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "約束した時間に、mukaiの裏口まで二人で歩いた。"
          }
