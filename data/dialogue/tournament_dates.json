      "branches": {
        "eve_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "凛想さんは買い物袋を下げていた。中身は新商品のサンプルではなかった。"
          },
          {
            "speaker": "rio",
            "face": "normal",
            "text": "足、痛くない？　絆創膏。あと水"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "品質管理ですか"
          },
          {
            "speaker": "rio",
            "face": "normal",
            "text": "そういう口実も、今日は休み"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "じゃあ、少し手をつないで歩きませんか"
          },
          {
            "speaker": "rio",
            "face": "normal",
            "text": "……申請が遅い"
          },
          {
            "speaker": "",
            "face": "",
            "text": "差し出した手を取ってから、凛想さんが笑った。"
          }
        ],
        "eve_dubai": [
          {
            "speaker": "",
            "face": "",
            "text": "凛想さんは、宿の売店の袋を下げていた。中身は水と、のど飴だった。"
          },
          {
            "speaker": "rio",
            "face": "normal",
            "text": "こっちは乾くから、喉からやられるよ。明日、声が出ないと困るでしょ"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "凛想さんこそ、昼はずっと香水の店を見てましたね"
          },
          {
            "speaker": "rio",
            "face": "normal",
            "text": "仕入れの下見。……って言うつもりだったけど、今日は嘘"
          },
          {
            "speaker": "rio",
            "face": "smile",
            "text": "君の隣で、知らない匂いを嗅ぎたかっただけ"
          },
          {
            "speaker": "",
            "face": "",
            "text": "歩き出すと、凛想さんの方から指を絡めてきた。"
          }
        ],
        "stay": [
          {
            "speaker": "",
            "face": "",
            "text": "凛想さんが買ってきた水を、二人で半分ずつ飲んだ。"
