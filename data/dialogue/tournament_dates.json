        "private_scene": true
      },
      "branches": {
        "stay": [
          {
            "speaker": "",
            "face": "",
            "text": "黙ったまま、つないだ手の震えが止まるのを待った。"
          },
          {
            "speaker": "",
            "face": "",
            "text": "約束した時間に、宿のロビーまで二人で歩いた。"
          }
        ],
        "home": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "今日、会えてよかった"
          },
          {
            "speaker": "",
            "face": "",
            "text": "あげはは手を離す前に、一度だけ強く握った。震えたままの指で、ピースを作って見せた。"
          }
        ]
