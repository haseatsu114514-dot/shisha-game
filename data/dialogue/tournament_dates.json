        "home_tokyo": [
          {
            "speaker": "",
            "face": "",
            "text": "別れ際、凛想さんは絆創膏をもう一枚、俺の鞄の外ポケットに差し込んだ。"
          }
        ],
        "home_dubai": [
          {
            "speaker": "",
            "face": "",
            "text": "別れ際、凛想さんはのど飴をひと粒、黙って俺の手のひらに置いた。"
