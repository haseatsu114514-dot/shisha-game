  "dialogues": [
    {
      "dialogue_id": "tournament_date_tsumugi",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "二人で駅前のベンチに座る。つむぎは旅先の木を描いていた。"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……明日は、手だけ描いても、いいですか"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "顔じゃなくて？"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "炭を待っている時の手、好きなので"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "じゃあ今は？"
        },
        {
          "speaker": "tsumugi",
          "face": "normal",
          "text": "……今は、貸してください"
        },
        {
          "speaker": "",
          "face": "",
          "text": "鉛筆をしまったつむぎの指が、俺の手を握った。"
        },
