{
  "comment": "来訪予定が確定し、実際に到着した恋人用。同行者の決定だけで再生しない。",
  "dialogues": [
    {
      "dialogue_id": "ch4_kuyuri_dubai_girlfriend",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "ロビーへ下りると、りんさんが上着を腕に掛けて待っていた。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "手には、市場で買ったらしいカルダモンの小袋。"
        },
        {
          "speaker": "kuyuri",
          "face": "normal",
          "text": "申請は「最重要サンプルの品質管理」。……業務は午後で終わり"
        },
        {
          "speaker": "kuyuri",
          "face": "normal",
          "text": "ここからは、私の休み"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "……来てくれて、うれしいです"
        },
        {
          "speaker": "kuyuri",
          "face": "normal",
          "text": "……うん。それを聞きに来たところもある"
        },
        {
          "speaker": "kuyuri",
          "face": "normal",
          "text": "明日の煙は明日。まず、夕飯にしよう"
        }
      ]
    }
  ]
}
