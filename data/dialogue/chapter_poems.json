{
  "dialogues": [
    {
      "dialogue_id": "poem_ch1",
      "metadata": {
        "poem": true,
        "panel": "poem_ch1.svg",
        "panel_alt": "カウンターの席に着いた客の背中と、流れてくる一筋の煙（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "作った者は 一台目を 忘れる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "吸った者だけが 覚えている"
        },
        {
          "speaker": "",
          "face": "",
          "text": "味は 覚えている",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "手順も 覚えている"
        },
        {
          "speaker": "",
          "face": "",
          "text": "覚えていないのは"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰に 作ったかだけだ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch2",
      "metadata": {
        "poem": true,
        "panel": "poem_ch2.svg",
        "panel_alt": "高い壁と、その向こうに浮かぶ王冠（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "いくつ 勝てば"
        },
        {
          "speaker": "",
          "face": "",
          "text": "足りると 言えるのだろう"
        },
        {
          "speaker": "",
          "face": "",
          "text": "順位を 聞かれて 順位を 答え"
        },
        {
          "speaker": "",
          "face": "",
          "text": "味を 聞かれても 順位を 答えた"
        },
        {
          "speaker": "",
          "face": "",
          "text": "その夜 向かいで 誰かが"
        },
        {
          "speaker": "",
          "face": "",
          "text": "話の 続きを 飲み込んだ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "壁は いつも 両側から 高い",
          "gap": true
        }
      ]
    },
    {
      "dialogue_id": "poem_ch3",
      "metadata": {
        "poem": true,
        "panel": "poem_ch3.svg",
        "panel_alt": "煙と、鏡に映る煙（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "甘いと 言った 嘘を"
        },
        {
          "speaker": "",
          "face": "",
          "text": "笑わずに 受け取った 手が あった"
        },
        {
          "speaker": "",
          "face": "",
          "text": "嘘は それから"
        },
        {
          "speaker": "",
          "face": "",
          "text": "少しだけ 本当に なった"
        },
        {
          "speaker": "",
          "face": "",
          "text": "煙は 嘘が 上手い",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "鏡は 嘘が 下手だ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じ部屋に 置かれた夜"
        },
        {
          "speaker": "",
          "face": "",
          "text": "嘘つきたちは 己の 顔を 見る"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch4",
      "metadata": {
        "poem": true,
        "panel": "poem_ch4.svg",
        "panel_alt": "手から手へ渡っていく器（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "勝った方が 作る"
        },
        {
          "speaker": "",
          "face": "",
          "text": "そう 決めた 二人の 夜から"
        },
        {
          "speaker": "",
          "face": "",
          "text": "負けた方は"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰に 作っていたのだろう"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch5",
      "metadata": {
        "poem": true,
        "panel": "poem_ch5.svg",
        "panel_alt": "数字の格子が、手の線へほどけていく（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "君の いちばん いい 日を"
        },
        {
          "speaker": "",
          "face": "",
          "text": "明日も 君が 作れるとは 限らない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "だから 私は 作った"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰の 手が 震えても"
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じ 一台が 出る 機械を"
        },
        {
          "speaker": "",
          "face": "",
          "text": "私は 九千の 夜で できている",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰かが 焦がした 夜"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰かが 直した 夜"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰かが 勝った 夜"
        },
        {
          "speaker": "",
          "face": "",
          "text": "それなのに 今夜だけが"
        },
        {
          "speaker": "",
          "face": "",
          "text": "まだ 記録に ない"
        }
      ]
    }
  ]
}
