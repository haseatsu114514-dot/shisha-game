{
  "dialogues": [
    {
      "dialogue_id": "poem_ch1",
      "metadata": {
        "poem": true,
        "panel": "poem_ch1.svg",
        "panel_alt": "カウンターの席に着いた客の背中と、流れてくる一筋の煙（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙は 葉のものでも"
        },
        {
          "speaker": "",
          "face": "",
          "text": "炭のものでも"
        },
        {
          "speaker": "",
          "face": "",
          "text": "作り手のものでも ない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "今 席に着いた 一人のものだ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch2",
      "metadata": {
        "poem": true,
        "panel": "poem_ch2.svg",
        "panel_alt": "高い壁と、その向こうに浮かぶ王冠（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "才に 憧れる者は 手順を 持ち"
        },
        {
          "speaker": "",
          "face": "",
          "text": "手順に 憧れる者は 才を 持つ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "王冠は いつも",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "向こう側に ある"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch3",
      "metadata": {
        "poem": true,
        "panel": "poem_ch3.svg",
        "panel_alt": "煙と、鏡に映る煙（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙は 嘘が 上手い"
        },
        {
          "speaker": "",
          "face": "",
          "text": "鏡は 嘘が 下手だ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じ部屋に 置かれた夜",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "嘘つきたちは 己の 顔を 見る"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch4",
      "metadata": {
        "poem": true,
        "panel": "poem_ch4.svg",
        "panel_alt": "手から手へ渡っていく器（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙は 手渡しできない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "渡せるのは 器と 火と 手順だけ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "それでも 煙は 渡ってきた",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "名も知らぬ 手の 一服から"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch5",
      "metadata": {
        "poem": true,
        "panel": "poem_ch5.svg",
        "panel_alt": "数字の格子が、手の線へほどけていく（仮絵）"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "同じ葉 同じ器具 同じ十二グラム"
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じ手順 同じ温度 同じ時間"
        },
        {
          "speaker": "",
          "face": "",
          "text": "ただ 一つ",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じに できなかった もの"
        }
      ]
    }
  ]
}