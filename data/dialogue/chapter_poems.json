{
  "dialogues": [
    {
      "dialogue_id": "poem_ch1",
      "metadata": {
        "poem": true,
        "panel": "poem_ch1.webp",
        "panel_alt": "開店前のカウンターに並ぶ刻んだ葉、炭、水の入ったガラスベース。その向こうに畑と海辺が浮かび、横ではじめが見つめている"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "葉は 異国の 畑から 香りを 纏い"
        },
        {
          "speaker": "",
          "face": "",
          "text": "炭は 南の 椰子殻に 火を 宿し"
        },
        {
          "speaker": "",
          "face": "",
          "text": "水は 今朝の 蛇口から 硝子に 満ちる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "本来 出会わぬ ものたちが",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "一台の 煙で 落ち合う"
        },
        {
          "speaker": "",
          "face": "",
          "text": "それが 店の 開く 合図だ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch2",
      "metadata": {
        "poem": true,
        "panel": "poem_ch2.webp",
        "panel_alt": "一枚の壁をはさんで、内側に座り込むあげはと、外側でノートを開くはじめ"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "勘で 煙を 立てる 者は"
        },
        {
          "speaker": "",
          "face": "",
          "text": "狂った 熱を 戻す 地図を 持たない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "手順で 煙を 立てる 者は"
        },
        {
          "speaker": "",
          "face": "",
          "text": "地図の 尽きた 先へ 踏み出せない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "壁は たった 一枚だ",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "だが 両側から 等しく 高い"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch3",
      "metadata": {
        "poem": true,
        "panel": "poem_ch3.webp",
        "panel_alt": "暗い店の灯りの下で、目を伏せて小さく笑うましろ"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "平気な 顔で 煙を 吐き"
        },
        {
          "speaker": "",
          "face": "",
          "text": "隣に 席を 一つ 空けておく"
        },
        {
          "speaker": "",
          "face": "",
          "text": "煙越しに 何も 聞かないのは",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "僕も 一つ 嘘を ついて"
        },
        {
          "speaker": "",
          "face": "",
          "text": "平気な 顔を 装うからだ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch4",
      "metadata": {
        "poem": true,
        "panel": "poem_ch4.webp",
        "panel_alt": "夜の飛行機の窓辺で、道具のケースを抱えるはじめ。窓に顔が映り、下に暗い海と街の灯り"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "言葉は 暗い 海を 渡れなかった"
        },
        {
          "speaker": "",
          "face": "",
          "text": "だから 俺は",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "生まれた 国の 匂いを 詰めて"
        },
        {
          "speaker": "",
          "face": "",
          "text": "一台の 煙で 海を 越える"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch5",
      "metadata": {
        "poem": true,
        "panel": "poem_ch5.webp",
        "panel_alt": "昔のカウンターで砂を見つめる若い頃の博士と、今の研究室でロボットの指を組み立てる博士"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "何を 吸っても 煙は 砂の 味だった"
        },
        {
          "speaker": "",
          "face": "",
          "text": "だから 私は",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "味を 知らずに 煙を 立てる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "舌の いらない 神を 組み立てた"
        }
      ]
    }
  ]
}
