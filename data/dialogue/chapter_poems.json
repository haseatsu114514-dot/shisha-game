{
  "dialogues": [
    {
      "dialogue_id": "poem_prologue",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙《スモーク》に 核は ない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "ゆえに 誰の 肺にも 入れる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "葉と 炭と 水と 手と",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "今日の 縁《えん》が 交わる 一点に"
        },
        {
          "speaker": "",
          "face": "",
          "text": "一筋の 煙が 立つ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "その名を 人は",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "水煙《すいえん》と 呼ぶ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch1",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙は 糸に 似ている"
        },
        {
          "speaker": "",
          "face": "",
          "text": "見えぬ 者同士を 音もなく 結ぶ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "憧れは 遠くを 見る",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "仕事は 足元を 見る"
        },
        {
          "speaker": "",
          "face": "",
          "text": "糸は その間を 通って"
        },
        {
          "speaker": "",
          "face": "",
          "text": "今夜 最初の 一人へ 届く"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch2",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "壁の 向こうで 誰かが"
        },
        {
          "speaker": "",
          "face": "",
          "text": "こちらを 天才と 呼んでいる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "王冠は いつも 向こう側に 見える",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "かぶった者に 見えるのは"
        },
        {
          "speaker": "",
          "face": "",
          "text": "空洞《ホロウ》だけだ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch3",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙《スモーク》は 嘘が 上手い"
        },
        {
          "speaker": "",
          "face": "",
          "text": "見たいものだけを 見せる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "鏡《ミラー》は 嘘が 下手だ",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "見たくないものまで 映す"
        },
        {
          "speaker": "",
          "face": "",
          "text": "その二つを 同じ部屋に 置いた夜",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "嘘つきたちは 己の 顔を 見る"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch4",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "煙は 手渡しできない"
        },
        {
          "speaker": "",
          "face": "",
          "text": "渡せるのは 器と 火と 手順だけ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "それでも 煙は 渡ってきた",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "名も知らぬ 誰かの 手つきで"
        },
        {
          "speaker": "",
          "face": "",
          "text": "今 己の 手が 動いている"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch5",
      "metadata": {
        "poem": true
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "同じ葉 同じ器具 同じ十二グラム"
        },
        {
          "speaker": "",
          "face": "",
          "text": "全ての 条件が 揃ってなお"
        },
        {
          "speaker": "",
          "face": "",
          "text": "残るものが あるとしたら"
        },
        {
          "speaker": "",
          "face": "",
          "text": "数字に ならなかった もの",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "あるいは"
        },
        {
          "speaker": "",
          "face": "",
          "text": "数字《データ》に した 誰かの 手"
        }
      ]
    }
  ]
}