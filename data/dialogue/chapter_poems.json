{
  "dialogues": [
    {
      "dialogue_id": "poem_ch1",
      "metadata": {
        "poem": true,
        "panel": "poem_ch1.webp",
        "panel_alt": "夜のtonari。カウンター席に着いた客の背中と、水のグラスを置くスミさん"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "作った者は 一台目を 忘れる"
        },
        {
          "speaker": "",
          "face": "",
          "text": "吸った者だけが 覚えている"
        },
        {
          "speaker": "",
          "face": "",
          "text": "味は 覚えている",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "手順も 覚えている"
        },
        {
          "speaker": "",
          "face": "",
          "text": "覚えていないのは"
        },
        {
          "speaker": "",
          "face": "",
          "text": "誰に 作ったかだけだ"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch2",
      "metadata": {
        "poem": true,
        "panel": "poem_ch2.webp",
        "panel_alt": "明るい店の窓の中で笑うあげはと、外の暗い通りから見つめるはじめの後ろ姿"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "いくつ 勝てば"
        },
        {
          "speaker": "",
          "face": "",
          "text": "足りると 言えるのだろう"
        },
        {
          "speaker": "",
          "face": "",
          "text": "順位を 聞かれて 順位を 答え"
        },
        {
          "speaker": "",
          "face": "",
          "text": "味を 聞かれても 順位を 答えた"
        },
        {
          "speaker": "",
          "face": "",
          "text": "その夜 向かいで 誰かが"
        },
        {
          "speaker": "",
          "face": "",
          "text": "話の 続きを 飲み込んだ"
        },
        {
          "speaker": "",
          "face": "",
          "text": "壁は いつも 両側から 高い",
          "gap": true
        }
      ]
    },
    {
      "dialogue_id": "poem_ch3",
      "metadata": {
        "poem": true,
        "panel": "poem_ch3.webp",
        "panel_alt": "閉店後の路地。綾取・ましろ・はじめが並び、背後のガラス戸に三人の姿が映る"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "分かったふりを した"
        },
        {
          "speaker": "",
          "face": "",
          "text": "知らない 味の 名前を"
        },
        {
          "speaker": "",
          "face": "",
          "text": "知っている 声で 言った"
        },
        {
          "speaker": "",
          "face": "",
          "text": "渡された 一台は",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "何も 言わずに"
        },
        {
          "speaker": "",
          "face": "",
          "text": "俺の 嘘を 煙にして 返した"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch4",
      "metadata": {
        "poem": true,
        "panel": "poem_ch4.webp",
        "panel_alt": "路地裏のカフェで、年配の手から若い手へ渡る小さなガラスのグラス"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "古い 器には"
        },
        {
          "speaker": "",
          "face": "",
          "text": "知らない 誰かの 指の 跡がある"
        },
        {
          "speaker": "",
          "face": "",
          "text": "俺の 指も いつか",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "知らない 誰かの 器に 残る"
        }
      ]
    },
    {
      "dialogue_id": "poem_ch5",
      "metadata": {
        "poem": true,
        "panel": "poem_ch5.webp",
        "panel_alt": "光の下、同じ量の葉を盛った二つの皿の上で止まる、人の手と機械の手"
      },
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "同じ葉 同じ器具 同じ十二グラム"
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じ手順 同じ温度 同じ時間"
        },
        {
          "speaker": "",
          "face": "",
          "text": "ただ 一つ",
          "gap": true
        },
        {
          "speaker": "",
          "face": "",
          "text": "同じに できなかった もの"
        }
      ]
    }
  ]
}
