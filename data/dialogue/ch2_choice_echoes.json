      "branches": {
        "rest": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（休んだ時間まで、無駄だったことにしたくない）"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（味はまだ遠い。でも、休むと決めた自分まで責めなくていい）"
          }
        ],
        "listened": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（なるさんと、点のつかない話をする約束をしたんだった）"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（お母さんの誕生日の話は、最後まで聞けた。返事はまだない。……明日が終わったら、もう一度送ろう）"
          }
        ],
        "check_hurt": [
          {
            "type": "condition",
            "condition_type": "flag",
            "flag": "_ch2_naru_hurt",
            "next_true": "hurt"
          }
        ],
        "hurt": [
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（なるさんには、謝ったままだ。既読はついたのに、返事はまだ来ない）"
          },
          {
            "speaker": "hajime",
            "face": "normal",
            "text": "（勝ち負けの話はしてない。……あの声が、まだ耳に残ってる）"
          }
        ]
      }
