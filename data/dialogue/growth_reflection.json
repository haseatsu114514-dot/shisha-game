{
  "dialogues": [
    {
      "dialogue_id": "reflect_kannon",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "境内は静かだ。手を合わせて、目を閉じる。願い事はしない。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "合わせた手のひらに、トングの重さが戻ってくる。置いた炭の数も、聞いた声も。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "思い出したことが、胸の奥で小さな火になっていく。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_tokyo_shrine",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "公園の池に、小さなお堂が浮かんでいる。短い橋を渡ると、街の音が水の向こうへ遠のいた。"
        },
        {
          "speaker": "hajime",
          "face": "normal",
          "text": "（弁天様は、芸事の神様だっけ。シーシャを作るのも、芸のうちかな）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "手を合わせて、目を閉じる。願い事はしない。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "水の向こうの街の音に、かけてもらった声が一つずつ重なっていく。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "思い出したことが、胸の奥で小さな火になっていく。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_dubai_mosque",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "風の回廊モスク。服装を整え、靴を脱ぎ、案内に従って見学する。礼拝の時間は避けている。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "見学を終え、中庭の回廊へ。柱の陰に腰をおろし、水の音を聞きながら、ここまでの旅を振り返る。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "膝の上で、指がひとりでに炭を置く形になった。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "思い出したことが、胸の奥で小さな火になっていく。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_dubai_waterside",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "夕暮れの水辺。対岸にモスクの灯りが見える。夜の見学は受け付けていない。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "手すりにもたれて、ここまでの旅を振り返る。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "対岸の灯りを、端から数える。数えるたび、誰かの手つきが一つ浮かんだ。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "思い出したことが、胸の奥で小さな火になっていく。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_inn_window",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "宿の窓辺。遠くの灯りを眺めながら、ここまでの日々を振り返る。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "窓ガラスに映った手を、握って、開く。指が、今日までの手順を順になぞった。"
        },
        {
          "speaker": "",
          "face": "",
          "text": "思い出したことが、胸の奥で小さな火になっていく。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_eve",
      "lines": [
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（明日は大会か……）"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（火種がまだ残ってる。眠る前に、少しだけ静かな所にいたい）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "ひとりで静かな場所へ向かった。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_eve_home",
      "lines": [
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（明日は大会か……）"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（火種がまだ残ってる。寝る前に、少しだけ歩いてこよう）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "上着を羽織って、はじめはもう一度だけ家を出た。向かうのは、近所の観音堂だ。"
        }
      ]
    },
    {
      "dialogue_id": "reflect_eve_slept",
      "lines": [
        {
          "speaker": "",
          "face": "",
          "text": "夜中に、ふと目が覚めた。"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（明日は大会か……）"
        },
        {
          "speaker": "hajime",
          "face": "serious",
          "text": "（火種がまだ残ってる。このまま目を閉じても、眠れそうにない）"
        },
        {
          "speaker": "",
          "face": "",
          "text": "上着を羽織って、はじめはそっと家を出た。向かうのは、近所の観音堂だ。"
        }
      ]
    }
  ]
}
