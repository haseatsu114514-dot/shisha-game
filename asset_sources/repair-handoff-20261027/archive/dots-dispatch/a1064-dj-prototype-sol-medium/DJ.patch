+    gains(this.mix.mix).forEach((g, id) => {
+      const p = this.voices[id]?.gain.gain;
+      if (p) { p.cancelScheduledValues(this.now); p.setValueAtTime(p.value, this.now); p.linearRampToValueAtTime(g, this.now + .012); }
